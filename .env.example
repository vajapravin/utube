# ==============================================================================
# mytube Environment Configuration (.env.example)
# ==============================================================================

# Application & Environment
APP_NAME=mytube
APP_ENV=production
PUBLIC_BASE_URL=https://utube.vajapravin.me
APP_SECRET_KEY=dev-insecure-secret-key-must-be-replaced-with-64-random-bytes-in-production

# Host Port Mappings (strictly non-conflicting)
WEB_PORT=3005
API_PORT=8005
POSTGRES_PORT=5436
REDIS_PORT=6381
MOCK_OIDC_PORT=8087

# Authentication (Google OIDC via PKCE)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=vajapravin23@gmail.com
ALLOWED_DOMAINS=
OPEN_REGISTRATION=false

# PostgreSQL Database (Alpine 16)
POSTGRES_DB=mytube
POSTGRES_USER=mytube
POSTGRES_PASSWORD=mytube_secure_dev_password_change_in_prod
DATABASE_URL=postgresql+asyncpg://mytube:mytube_secure_dev_password_change_in_prod@postgres:5432/mytube

# Redis 7 Cache & Job Queue
REDIS_URL=redis://redis:6379/0

# Video Source Provider (youtube_data_api | fake)
VIDEO_SOURCE=youtube_data_api
YT_API_KEY=
YT_DAILY_QUOTA_BUDGET=9000
YT_DEFAULT_REGION=GB
SHORTS_MAX_SECONDS=180
SHORTS_STRICT_CHECK=false

# LLM Curation Provider (gemini | ollama | anthropic | openai | fake)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Curation Pipeline Parameters
LLM_DAILY_CALLS_PER_USER=50
CURATION_MIN_SCORE=60
CHANNEL_MAX_VIDEOS=60
CHANNEL_MAX_SHORTS=40
CHANNEL_REFRESH_HOURS=24
CATEGORY_REFRESH_HOURS=12

# Cloudflare Ingress (optional for standalone dev container)
CF_TUNNEL_TOKEN=

# Persistent Storage & Backups (Synology NAS)
DATA_ROOT=/volume1/docker/mytube
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=mytube-backups
